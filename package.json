{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npx tsx --cwd packages/opencode --conditions=browser src/index.ts",
    "dev:desktop": "npm --prefix packages/desktop run dev",
    "dev:web": "npm --prefix packages/app run dev",
    "dev:console": "ulimit -n 10240 2>/dev/null; npm run --prefix packages/console/app dev",
    "dev:stats": "npx sst shell --stage=production -- npm run --prefix packages/stats/app dev",
    "dev:storybook": "npm --prefix packages/storybook run storybook",
    "lint": "oxlint",
    "typecheck": "npx turbo typecheck",
    "upgrade-opentui": "npx tsx script/upgrade-opentui.ts",
    "postinstall": "npm run --prefix packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "sso": "aws sso login --sso-session=opencode --no-browser",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": [
    "packages/*",
    "packages/console/*",
    "packages/stats/*",
    "packages/sdk/js",
    "packages/slack"
  ],
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@tsconfig/node22": "22.0.2",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "sst": "4.13.1",
    "turbo": "2.8.13"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@opencode-ai/plugin": "*",
    "@opencode-ai/script": "*",
    "@opencode-ai/sdk": "*",
    "heap-snapshot-toolkit": "1.1.3",
    "typescript": "5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@opentui/core": "0.3.4",
    "@opentui/keymap": "0.3.4",
    "@opentui/solid": "0.3.4",
    "@types/node": "24.12.2"
  }
}
